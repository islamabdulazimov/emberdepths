extends SceneTree
const T = preload("res://data/battle.gd")
var failures := 0
var main: Node2D
func check_result(ok: bool, message: String) -> void:
 if ok: print("PASS: ",message)
 else:
  failures += 1
  push_error(message)
func _initialize() -> void: call_deferred("run")
func ready_player() -> void:
 main.player.fighter.reset()
 main.player.equipment["ability"]="traveler_knot"
 main.player.roll_cooldown=0
 main.player.hurt_immunity = 0
 main.player.resources.reset_full()
 main.player.velocity = Vector2.ZERO
 main.player.position = Vector2(1544,342)
 main.player.facing = 1
 main.player.swing_remaining = 0
 main.items.attack_ready_at.clear()
 main.items.local_inventory().load_data([])
 main.items.local_inventory().add("stone_blade",1)
func run() -> void:
 main = load("res://scenes/main.tscn").instantiate()
 root.add_child(main)
 main.set_physics_process(false)
 main.interaction.set_process(false)
 main.combat.set_physics_process(false)
 main.items.set_physics_process(false)
 main.player.set_physics_process(false)
 main.encounter.enabled = false
 for x in range(82,113):
  for y in range(12,22): main.world.apply_edit(Vector2i(x,y),-1)
  main.world.apply_edit(Vector2i(x,22),2)
 main.world.solid.update_internals()
 await physics_frame
 await physics_frame
 ready_player()
 var combat = main.combat
 var player = main.player
 var enemy_id: int = combat.spawn_entity("ashling",Vector2(1576,352))
 var enemy = combat.entities[enemy_id]
 enemy.grace = 0
 check_result(main.items.swing(player,0,Vector2.RIGHT) and enemy.health == 45 and player.fighter.phase() == "attack_windup","Blade starts with a real windup and no instant damage")
 check_result(not player.resources.snapshot().has("stamina") and not main.items.swing(player,0,Vector2.RIGHT),"Attack has no resource cost and cannot be spammed during phases")
 combat.tick_fighter(player,0.119)
 check_result(enemy.health == 45,"End of windup still cannot hit")
 combat.tick_fighter(player,0.002)
 check_result(enemy.health == 21 and player.fighter.phase() == "attack_active","Active phase deals strong damage to ordinary enemy")
 combat.tick_fighter(player,0.05)
 check_result(enemy.health == 21,"One active swing cannot hit the same enemy repeatedly")
 combat.tick_fighter(player,0.06)
 check_result(player.fighter.phase() == "attack_recovery" and not combat.start_defense(1,"roll"),"Recovery prevents attack cancellation into a free roll")
 combat.tick_fighter(player,0.25)
 check_result(player.fighter.mode == "idle","Attack returns control after configured recovery")
 check_result(main.items.swing(player,0,Vector2.RIGHT),"A second committed attack can begin")
 combat.tick_fighter(player,T.BLADE.windup+0.001)
 check_result(not combat.entities.has(enemy_id),"Two blade hits defeat a solo ashling without increasing its health")
 ready_player()
 enemy_id = combat.spawn_entity("ashling",Vector2(1592,352))
 combat.entities[enemy_id].grace = 0
 main.items.swing(player,0,Vector2.RIGHT)
 combat.tick_fighter(player,0.13)
 check_result(combat.entities[enemy_id].health == 45,"Targets beyond the blade tip and collider radius are out of reach")
 combat.set_entity(enemy_id,{})
 ready_player()
 check_result(combat.start_defense(1,"roll") and player.roll_cooldown == T.ROLL.cooldown,"Ground roll starts its configured cooldown")
 check_result(not player.fighter.roll_invulnerable() and not combat.start_defense(1,"roll"),"Roll startup is vulnerable and repeated input cannot restart it")
 player.fighter.advance(0.06)
 var anchor: Vector2 = player.position
 check_result(combat.receive_attack(1,22,anchor+Vector2(20,0),main.encounter) == "dodged" and player.health == 100,"Short roll window avoids an actual hit")
 player.fighter.advance(0.22)
 check_result(not player.fighter.roll_invulnerable() and combat.damage_player(1,14,anchor+Vector2(20,0)),"Roll recovery is vulnerable again")
 check_result(not combat.damage_player(1,14,anchor) and player.health == 86,"Hurt immunity prevents an unavoidable damage chain")
 ready_player()
 check_result(not combat.start_defense(1,"roll",INF) and player.roll_cooldown == 0,"Invalid directional input cannot start or pay for a defense")
 check_result(combat.start_defense(1,"roll",-1) and player.fighter.direction.x == -1,"A held movement direction can choose a backward roll without waiting for a facing update")
 ready_player()
 player.equipment.ability=""
 check_result(not combat.start_defense(1,"roll") and combat.start_defense(1,"parry"),"Missing ability blocks roll while parry stays available")
 ready_player()
 player.position.y = 64
 check_result(not combat.start_defense(1,"roll"),"Ground roll cannot restart in midair")
 ready_player()
 enemy_id = combat.spawn_entity("ashling",Vector2(1572,352))
 enemy = combat.entities[enemy_id]
 enemy.grace = 0
 check_result(enemy.step_attack(0,player,combat) and enemy.attack_state == "windup" and player.health == 100,"Ashling announces its attack instead of hurting by touch")
 enemy.step_attack(0.47,player,combat)
 check_result(player.health == 100 and enemy.attack_state == "windup","Enemy windup remains harmless")
 enemy.step_attack(0.02,player,combat)
 check_result(enemy.attack_state == "active" and player.health == 100,"Enemy active cue precedes its first damage frame")
 combat.start_defense(1,"parry")
 player.fighter.advance(0.06)
 enemy.step_attack(0.01,player,combat)
 check_result(player.health == 100 and player.fighter.mode == "parry_success" and enemy.attack_state == "stagger","Timed parry cancels enemy hit and opens a riposte window")
 enemy.step_attack(1.01,player,combat)
 check_result(enemy.attack_state == "chase","Parried enemy eventually resumes combat")
 ready_player()
 enemy.position = Vector2(1572,352)
 enemy.change_attack("active")
 enemy.attack_facing = -1
 combat.start_defense(1,"parry")
 player.fighter.advance(0.25)
 check_result(not player.fighter.parry_open() and not combat.start_defense(1,"parry"),"Missed parry has a real recovery and cannot be mashed")
 enemy.step_attack(0.01,player,combat)
 check_result(player.health == 86,"An expired parry window does not block the enemy hit")
 ready_player()
 enemy.change_attack("active")
 player.facing = -1
 combat.start_defense(1,"parry")
 player.fighter.advance(0.06)
 enemy.step_attack(0.01,player,combat)
 check_result(player.health == 86,"Directional parry cannot block a strike from behind")
 combat.set_entity(enemy_id,{})
 ready_player()
 main.encounter.enabled = true
 main.encounter.pending = true
 main.encounter.kills = 3
 check_result(main.encounter.try_spawn(),"Existing three-kill progression still summons Andrew")
 var boss = main.encounter.actor
 boss.set_physics_process(false)
 boss.position = Vector2(1608,352)
 boss.locked_target = Vector2(1544,352)
 boss.enter_phase("super_windup",boss.definition.super_windup)
 boss.locked_target = Vector2(1544,352)
 combat.start_defense(1,"parry")
 player.fighter.advance(0.06)
 boss._damage_players("super")
 check_result(player.health == 100 and boss.state.poise == 90,"Red jump preparation is not a damage or parry window")
 player.fighter.advance(0.6)
 player.fighter.complete_tick()
 boss.enter_phase("super_impact",T.SUPER_IMPACT)
 boss.locked_target = Vector2(1544,352)
 boss._damage_players("super")
 check_result(player.health == 66 and boss.state.poise == 90,"Parrying early during red preparation expires before the real landing hit")
 ready_player()
 boss.enter_phase("super_impact",T.SUPER_IMPACT)
 boss.locked_target = Vector2(1544,352)
 combat.start_defense(1,"parry")
 player.fighter.advance(0.06)
 boss._damage_players("super")
 check_result(player.health == 100 and boss.state.health == boss.state.max_health and boss.state.poise == 45 and boss.phase == "super_recovery","Parrying actual landing cancels damage and removes substantial boss poise without health damage")
 ready_player()
 boss.enter_phase("uppercut_active",boss.definition.uppercut_active)
 boss.facing = -1
 boss.position = Vector2(1576,352)
 combat.start_defense(1,"parry")
 player.fighter.advance(0.06)
 boss._damage_players("uppercut")
 check_result(boss.phase == "stunned" and boss.state.poise == 0 and boss.phase_duration == 2.0,"A second parry breaks remaining poise for exactly two seconds")
 boss._damage_players("uppercut")
 check_result(player.health == 100,"Stunned Andrew cannot continue the cancelled attack")
 ready_player()
 boss.enter_phase("super_impact",T.SUPER_IMPACT)
 boss.locked_target = Vector2(1544,352)
 combat.start_defense(1,"roll")
 player.fighter.advance(0.06)
 boss._damage_players("super")
 check_result(player.health == 100,"A well timed roll also avoids the landing hit")
 ready_player()
 boss.enter_phase("super_impact",T.SUPER_IMPACT)
 boss.locked_target = Vector2(1544,352)
 boss.phase_elapsed = 0
 boss.impact_emitted = false
 boss._physics_process(T.SUPER_HIT_DELAY-0.005)
 check_result(player.health == 100,"Landing cue has a separate short delay before actual damage")
 boss._physics_process(0.01)
 check_result(player.health == 66,"Landing deals damage once its distinct impact moment arrives")
 var locked := Vector2i(97,22)
 ready_player()
 main.items.local_inventory().add("stone",3)
 check_result(not main.items.try_edit(player,locked,-1,main.get_node("Players").get_children()),"Boss fight blocks mining inside its visible zone")
 check_result(not main.items.place_selected(player,Vector2i(97,21),1),"Boss fight blocks solid placement inside the zone")
 main.items.local_inventory().add("stone_wall",3)
 check_result(not main.items.place_selected(player,Vector2i(97,21),2),"Background placement is protected too")
 main.items.local_inventory().add("torch",1)
 main.items.local_inventory().add("wood_door",1)
 main.items.local_inventory().add("wood_chest",1)
 check_result(main.items.placement_status(player,Vector2i(98,21),3).begins_with("Арена"),"Torch placement cannot bypass the arena boundary")
 check_result(main.items.placement_status(player,Vector2i(98,21),4).begins_with("Арена"),"Door footprints respect arena protection")
 check_result(main.items.placement_status(player,Vector2i(98,21),5).begins_with("Арена"),"Storage footprints respect arena protection")
 var outside := maxi(2,main.combat_zone.bounds.position.x-2)
 player.position = main.world.safe_spawn_position(outside)
 var outside_floor: Vector2i = main.world.cell_at(player.position+Vector2(0,10))
 check_result(not main.combat_zone.blocks_edit(outside_floor) and main.items.try_edit(player,outside_floor,-1,main.get_node("Players").get_children()),"Ordinary world outside the locked zone remains destructible during the fight")
 player.position = Vector2(1544,342)
 main.encounter.end_fight("test")
 check_result(not main.combat_zone.active and main.items.try_edit(player,locked,-1,main.get_node("Players").get_children()),"Fight end releases the protected terrain")
 ready_player()
 var empty_bag = load("res://scripts/inventory.gd").new()
 combat.set_chest(999,{"owner":1,"profile":main.saves.profile_id,"position":Vector2(1564,342),"contents":empty_bag.to_data()})
 main.items.swing(player,0,Vector2.RIGHT)
 combat.tick_fighter(player,0.13)
 combat.tick_fighter(player,0.05)
 check_result(combat.chests.has(999) and combat.entities.is_empty(),"legacy chest cannot be struck into a newborn spirit")
 ready_player()
 player.fighter.begin("parry",Vector2.RIGHT,T.PARRY.duration)
 var saved: Dictionary = main.saves.capture()
 check_result(not saved.profiles[main.saves.profile_id].life.has("action"),"Saves exclude transient attack and invulnerability windows")
 check_result(main.saves.restore(saved) == "" and main.player.fighter.mode == "idle","Loading restores a safe neutral action state")
 main.queue_free()
 await process_frame
 main = load("res://scenes/combat_arena.tscn").instantiate()
 root.add_child(main)
 main.set_physics_process(false)
 main.combat.set_physics_process(false)
 main.player.set_physics_process(false)
 check_result(not main.saves.automatic and not main.saves.owns_lock and not main.saves.can_save() and not main.saves.save_now(),"Arena cannot read lock overwrite or save the real profile")
 check_result(main.network.host_game() == ERR_UNAVAILABLE,"Solo practice scene does not start a second multiplayer implementation")
 check_result(main.items.local_inventory().item_at(0) == "stone_blade" and main.combat.entities.size() == 1,"Arena starts ready to test one weapon and ordinary enemy")
 main.world.apply_edit(Vector2i(96,26),-1)
 main.world.apply_edit(Vector2i(95,25),2)
 main.spawn_practice_boss()
 check_result(main.world.block_at(Vector2i(96,26)) == 2 and main.world.block_at(Vector2i(95,25)) == -1,"Starting an arena boss restores the authored floor and removes prebuilt traps")
 check_result(is_instance_valid(main.encounter.actor) and main.combat_zone.active and main.combat_zone.bounds == main.combat_zone.preset,"Arena boss uses the existing encounter and explicit fixed bounds")
 main.reset_arena()
 check_result(main.combat.entities.is_empty() and main.combat.chests.is_empty() and not main.combat_zone.active and main.player.health == 100,"Reset cleans only the temporary arena and returns a working fighter")
 print("Battle failures: ",failures)
 quit(1 if failures else 0)
